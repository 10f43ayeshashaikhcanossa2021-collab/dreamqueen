# ==============================================================================
# DreamQueen Atelier — Environment Variables Template
# Copy to .env and fill real values. NEVER commit real secrets to git.
# ==============================================================================

# Public Frontend & Supabase Connection (Safe for browser bundle with RLS enabled)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Server-Only Supabase Privileged Key (NEVER expose as VITE_* or commit to git)
# Used by server.ts for atomic stock checks, webhook updates, and admin verification.
SUPABASE_SERVICE_ROLE_KEY=""

# Public App URL
APP_URL="http://localhost:3000"

# Razorpay Payment Gateway (Server-Only Secret + Webhook Verification)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email Notifications (Resend API — Optional; falls back cleanly if unset)
RESEND_API_KEY=""
EMAIL_FROM="DreamQueen Atelier <orders@dreamqueen.in>"

# Shiprocket Shipping API (Optional; falls back to manual courier tracking if unset)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# WhatsApp Business Cloud API (Optional server-side auto-send; wa.me checkout link always works)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
MERCHANT_WHATSAPP_NUMBER="918097706536"

